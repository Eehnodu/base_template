# 이 파일을 .env 로 복사해 값을 채운다. 실행 환경은 APP_ENV(local | prod) 또는 호스트명으로 정해진다.

# MySQL
MYSQL_PORT=3306
LOCAL_MYSQL_USER=
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_HOST=localhost
LOCAL_MYSQL_DB=
PROD_MYSQL_USER=
PROD_MYSQL_PASSWORD=
PROD_MYSQL_HOST=
PROD_MYSQL_DB=

# 인증
JWT_SECRET=
HASH_KEY=

# Redis
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_PASSWORD=
PROD_REDIS_HOST=
PROD_REDIS_PORT=6379
PROD_REDIS_PASSWORD=

# 운영 CORS 허용 주소(쉼표 구분) · 쿠키 도메인
PROD_CORS_ORIGINS=
PROD_COOKIE_DOMAIN=

# OpenAI
OPENAI_API_KEY=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
LOCAL_KAKAO_REDIRECT_URI=
PROD_KAKAO_REDIRECT_URI=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOCAL_GOOGLE_REDIRECT_URI=
PROD_GOOGLE_REDIRECT_URI=
